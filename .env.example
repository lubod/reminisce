# PostgreSQL credentials
# A strong POSTGRES_PASSWORD must be configured for the docker-compose setup to launch.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Master secret for the whole system: JWT signing (api_secret_key), P2P identity
# derivation, backup-key wrapping and AI-service authentication all chain off it.
# Generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'
# Must be at least 32 characters. The AI service fails closed without it, so this
# MUST be set for embeddings/descriptions/face detection to work.
API_SECRET_KEY=

# Optional: coordinator (VPS) for WAN peer discovery + reverse tunnel.
# Requires the coordinator's 64-hex Node ID (identity binding) alongside the address.
COORDINATOR_ADDR=
COORDINATOR_NODE_ID=
TUNNEL_PUBLIC_URL=
