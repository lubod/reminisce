# Stage 1: Build all binaries in a single cached environment
FROM rust:bookworm@sha256:14bc9c5966e7b3a385794b3d5389a8765668342025fbcc7b2e3d2866ac4bd8c3 as builder
WORKDIR /usr/src/app

ARG CARGO_BUILD_JOBS=24

# 1. Copy workspace manifests
COPY Cargo.lock Cargo.toml ./
COPY np2p/Cargo.toml ./np2p/
COPY coordinator/Cargo.toml ./coordinator/

# 2. Create dummy source files to cache dependency compilation
RUN mkdir -p np2p/src/bin coordinator/src && \
    echo "fn main() {}" > np2p/src/bin/main.rs && \
    echo "fn main() {}" > np2p/src/bin/e2e_client.rs && \
    echo "pub fn dummy() {}" > np2p/src/lib.rs && \
    echo "fn main() {}" > coordinator/src/main.rs

# Build dependencies only
RUN cargo build -p np2p -p coordinator --release -j ${CARGO_BUILD_JOBS}

# 3. Copy actual source code
COPY np2p/src ./np2p/src
COPY coordinator/src ./coordinator/src

# Remove dummy artifacts to force re-compilation of our crates
RUN rm -f target/release/deps/np2p* target/release/deps/libnp2p* \
          target/release/deps/coordinator* \
          target/release/np2pd* target/release/e2e_client* target/release/coordinator*

# 4. Build all binaries
RUN cargo build --bin np2pd --bin e2e_client -p np2p \
                --bin coordinator -p coordinator --release -j ${CARGO_BUILD_JOBS}

# --- Runtime Stages ---

# Storage Node (Daemon)
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 as storage
RUN apt-get update && apt-get install -y ca-certificates procps && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/target/release/np2pd /usr/local/bin/
RUN groupadd --system --gid 10001 np2p \
    && useradd --system --uid 10001 --gid np2p --home-dir /nonexistent --shell /usr/sbin/nologin np2p \
    && mkdir -p /data \
    && chown -R np2p:np2p /data

USER np2p

EXPOSE 5050/udp
# np2pd only listens on UDP 5050 (no TCP socket to probe), so verify the process is
# alive AND its datagram socket is actually bound: port 5050 = hex 13BA in /proc/net/udp.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD pgrep -x np2pd >/dev/null && grep -qiE ':13BA[[:space:]]' /proc/net/udp || exit 1
CMD ["np2pd", "--listen", "0.0.0.0:5050", "--data-dir", "/data"]

# E2E Client Simulator
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 as client
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/target/release/e2e_client /usr/local/bin/
CMD ["e2e_client"]

# Coordinator (VPS relay + tunnel server)
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 as coordinator
RUN apt-get update && apt-get install -y ca-certificates procps && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/target/release/coordinator /usr/local/bin/
RUN groupadd --system --gid 10001 np2p \
    && useradd --system --uid 10001 --gid np2p --home-dir /nonexistent --shell /usr/sbin/nologin np2p \
    && mkdir -p /data \
    && chown -R np2p:np2p /data

USER np2p

EXPOSE 5055/udp 8443/tcp
# Real probe: TCP-connect to the coordinator's tunnel listener on 8443 via bash /dev/tcp.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8443' || exit 1
CMD ["coordinator", "--listen", "0.0.0.0:5055", "--tunnel-port", "8443", "--data-dir", "/data"]