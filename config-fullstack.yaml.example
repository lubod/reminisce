# Fullstack Docker configuration — copy to config-fullstack.yaml and fill in your values
# For the `./dev fullstack` flow (docker/docker-compose-dev.yml): all services run in
# Docker and the backend uses host network, so localhost works for port-mapped services.
# NOTE: the production docker-compose.yml does NOT use host network — there the backend
# reaches the AI service over the compose network (use http://ai-server:50051 for ai_grpc_url).

# Main database (Docker, port-mapped to host on 25432)
database_url: "postgres://postgres:postgres@localhost:25432/reminisce_db"
# Enforce database connection TLS via native-tls/postgres-native-tls (default: false)
db_tls: false

# Geotagging database (Docker, port-mapped to host on 5435)
geotagging_database_url: "postgres://postgres:postgres@localhost:5435/geotagging_db"

# Secret key for JWT tokens — generate with: openssl rand -base64 32
# Must match the key configured in your Android/mobile clients
api_secret_key: "CHANGE_ME_run_openssl_rand_base64_32"

# Upload directories (mounted as Docker volumes)
images_dir: "/app/uploaded_images"
videos_dir: "/app/uploaded_videos"

# P2P Configuration
p2p_data_dir: "/app/data/p2p"
# Coordinator address — storage nodes register here and are discovered automatically
p2p_coordinator_addr: "127.0.0.1:5055"
p2p_namespace: "production"

# Geocoding
enable_local_geocoding: true
enable_external_geocoding_fallback: true

# AI service (gRPC on :50051; embed, describe, detect, quality, enhance)
# Requires ai-server to publish 50051 (see docker-compose-dev.yml).
# If the backend runs inside the compose network (not host), use http://ai-server:50051
ai_grpc_url: "http://localhost:50051"

# Observability (in-app: rotating logs under /app/logs; GPU proxied from the AI container)
log_dir: "/app/logs"
ai_http_url: "http://ai-server:8081"
environment: "production"

# ─── Hardening options (2026-08) ───────────────────────────────
# Mesh admission: only these storage-node IDs may receive shards.
# Empty/absent = open admission (a warning is logged at startup).
# p2p_allowed_node_ids:
#   - <64-hex-home-server-node-id>
#   - <64-hex-storage-node-id>
#
# Memory-hard identity derivation. WARNING: changes your node_id;
# re-pair storage nodes when switching. Default: legacy (fast hash).
# p2p_identity_kdf: argon2id
#
# Extra CORS origins (the SPA is same-origin; usually leave empty).
# cors_allowed_origins:
#   - https://photos.example.com
#
# Reverse proxies allowed to set X-Real-IP/X-Forwarded-For for rate
# limiting. Loopback is always trusted; RFC1918 is NOT implicit.
# rate_limit_trusted_proxies:
#   - 192.168.1.197

